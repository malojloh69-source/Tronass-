{
  "schema": {
    "category": {
      "slug": "telegram",
      "title": "Telegram",
      "iconUrl": "/assets/categories/telegram.svg"
    },
    "filters": [
      {
        "key": "search",
        "label": "Поиск по названию",
        "type": "text",
        "query": "searchString",
        "icon": "Search"
      },
      {
        "key": "price",
        "label": "Цена",
        "type": "number-range",
        "queries": {
          "from": "priceFrom",
          "to": "priceTo"
        },
        "min": 0,
        "icon": "BadgeDollarSign"
      },
      {
        "key": "origin",
        "label": "Происхождение",
        "type": "select",
        "query": "origin",
        "optionsEndpoint": "/api/origins?category={slug}",
        "icon": "Boxes"
      },
      {
        "key": "excludeOrigin",
        "label": "Исключить происхождение",
        "type": "select",
        "query": "not_origin",
        "optionsEndpoint": "/api/origins?category={slug}",
        "icon": "Boxes"
      },
      {
